<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight builds must use the production APNs environment.
	     A release build shipped with "development" here registers against the
	     sandbox and silently receives nothing. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>

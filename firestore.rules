rules_version = '2';

// =============================================================================
// "You" Firestore security rules — hardened for the admin panel.
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
// KEY CHANGES vs the previous rules (read CAREFULLY before deploying):
//   1. REMOVED the catch-all `match /{document=**} { allow read, write: if auth != null }`.
//      That rule exposed every journal / chat / mood doc to every signed-in user
//      and made all per-collection rules below it pointless. Now anything NOT
//      explicitly matched below is DENIED by default — test your app flows.
//   2. Added isAdmin() and admins can now: read/update any users doc, read/update
//      volunteer_info, CRUD communities, moderate posts/replies, toggle app_settings,
//      and read daily_analytics.
//   3. Added explicit rules for volunteer_info/{uid}/reviews and daily_analytics,
//      which previously only worked because of the catch-all.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Reads the requester's own users doc. NOTE: each call costs one document read,
    // so always put the cheaper isOwner() check first so `||` short-circuits.
    function selfRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && selfRole() == 'admin';
    }
    // Lets any signed-in user like/unlike a post or reply without being its
    // author: the update may touch ONLY `likedBy`/`likeCount`, and the caller
    // may add or remove ONLY their own uid, with `likeCount` moving in lock-step
    // (+1 on like, -1 on unlike). This can't be used to edit content, tamper
    // with others' likes, or set an arbitrary count. (posts/replies are always
    // created with likedBy:[] and likeCount:0, so the fields always exist.)
    function isOwnLikeToggle() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likedBy', 'likeCount'])
        && (
          (!(request.auth.uid in resource.data.likedBy)
            && request.auth.uid in request.resource.data.likedBy
            && request.resource.data.likeCount == resource.data.likeCount + 1)
          ||
          (request.auth.uid in resource.data.likedBy
            && !(request.auth.uid in request.resource.data.likedBy)
            && request.resource.data.likeCount == resource.data.likeCount - 1)
        );
    }

    // --- notification relationship checks ---
    // Rules cannot run a query, so these resolve the specific chat / request the
    // notification names in its own payload and verify BOTH the sender and the
    // recipient are parties to it. Reads inside one rule evaluation are cached,
    // so each check costs a single billed document read.
    function notifTarget(key) {
      return request.resource.data.get('data', {}).get(key, '');
    }
    function sharesChatWith(recipientId) {
      let chatId = notifTarget('chatId');
      return chatId != ''
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        && recipientId in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    function sharesRequestWith(recipientId) {
      let reqId = notifTarget('requestId');
      let parties = reqId != ''
        && exists(/databases/$(database)/documents/chat_requests/$(reqId))
        ? [get(/databases/$(database)/documents/chat_requests/$(reqId)).data.requesterId,
           get(/databases/$(database)/documents/chat_requests/$(reqId)).data.volunteerId]
        : [];
      return request.auth.uid in parties && recipientId in parties;
    }

    // A chat participant may edit the chat doc, but NOT in ways that defeat the
    // safety model: they must not add a third reader to a private transcript,
    // and must not clear the escalation flag that marks the chat as evidence.
    // Escalating (false -> true) is allowed — EscalationService does it.
    function chatUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['participants'])
        && (!changed.hasAny(['escalated']) || request.resource.data.escalated == true);
    }

    // An aggregate the client maintains may only move by one, in either
    // direction. Stops a caller writing membersCount: 999999 or
    // averageRating: 5 / totalReviews: 9999 in a single request.
    function movesByOne(field) {
      return request.resource.data[field] == resource.data[field] + 1
          || request.resource.data[field] == resource.data[field] - 1;
    }

    // Fields on one's OWN users doc that the owner may NEVER write:
    //  • role / permissions      — otherwise ANY user could self-assign role:'admin'
    //                              and gain full admin powers (incl. reading all chats).
    //  • subscription* / welcomeChatsUsed — self-granted premium / reset billing counter.
    //  • status audit trail      — admin-authored record of a suspension/ban.
    // (`status` itself is handled separately by ownerStatusChangeOk() below, because the
    //  client legitimately sets it during onboarding.)
    function ownerForbiddenUserFields() {
      return ['role', 'permissions',
              'subscriptionTier', 'subscription_expiry', 'subscription_source',
              'welcomeChatsUsed',
              'statusReason', 'statusChangedBy', 'lastStatusChange'];
    }

    // The owner may change their own `status` ONLY during onboarding — never to escape a
    // moderation action. So: their CURRENT status must not already be blocked, and the new
    // value must be one the client is allowed to self-assign. A suspended/banned/deleted
    // user therefore cannot write themselves back to 'active'.
    function ownerStatusChangeOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || (
          !(resource.data.status in ['suspended', 'banned', 'deleted'])
          && request.resource.data.status in
               ['active', 'profile_incomplete', 'pending_verification']
        );
    }

    // =============================
    // users
    // =============================
    match /users/{userId} {
      // A user reads their own doc; an admin can read anyone's.
      allow get: if isOwner(userId) || isAdmin();
      // Listing is restricted to VOLUNTEER documents. `allow list: if isSignedIn()`
      // let any account page the whole collection and read every user's email,
      // phone, date of birth and FCM token — rules cannot project fields, so a
      // list returns whole documents. Firestore only permits a query when its
      // constraints prove every possible result satisfies this rule, so the
      // app's volunteer-discovery query (role == 'volunteer') is accepted and an
      // unconstrained collection read is rejected.
      //
      // NOTE: a volunteer's own contact fields are still visible to anyone who
      // lists volunteers. The complete fix is a `volunteers_public` projection
      // maintained by a Cloud Function — see docs/APP_QUALITY_REVIEW.md §4.4.
      allow list: if isAdmin() || (isSignedIn() && resource.data.role == 'volunteer');
      // Signup writes own doc; admins create other accounts (e.g. createAdminUser).
      allow create: if isOwner(userId) || isAdmin();
      // Profile self-edits, plus admin actions (role change, status, soft-delete, verify).
      // SECURITY: an owner may never write ownerForbiddenUserFields() — that covers
      // privilege escalation (role/permissions), self-granted premium (subscription* /
      // welcomeChatsUsed) and the admin status-audit trail. `status` is additionally
      // constrained by ownerStatusChangeOk() so a suspended/banned user cannot lift their
      // own moderation action. Everything else (profile, first_login_at, joinedCommunities,
      // availabilityStatus) stays self-editable.
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(ownerForbiddenUserFields())
                        && ownerStatusChangeOk());
      // SAFETY: never hard-delete a user (admins soft-delete via status:"deleted").
      allow delete: if false;

      // Private journal — owner only. Admins must NOT read journal content (privacy).
      match /journal/{journalId} {
        allow read, write: if isOwner(userId);
      }

      // Freemium usage counters (e.g. usage/dodo {date,count}). The owner may READ
      // their own; ONLY the Admin SDK (Cloud Functions) writes them, so the counts
      // stay authoritative and can't be reset by the client.
      match /usage/{feature} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Notifications. Creating one triggers the onNotificationCreated Cloud
      // Function, which pushes the title/body straight to the device via FCM —
      // so `allow create: if isSignedIn()` meant any account could send
      // arbitrary push notifications to any user. Now a cross-user create is
      // permitted only between people already in a relationship: the two
      // parties of a chat, or of a chat request.
      //
      // Each cross-user create costs one extra document read. The cheaper and
      // stricter end state is to route notification creation through a
      // callable, as the freemium writes already do — see §4.3.
      match /notifications/{notificationId} {
        allow create: if isOwner(userId)
                      || isAdmin()
                      || sharesChatWith(userId)
                      || sharesRequestWith(userId);
        allow read, update, delete: if isOwner(userId);
      }
    }

    // =============================
    // app_settings
    // =============================
    match /app_settings/global_config {
      allow read: if isSignedIn();
      // Admin panel toggles is_subscription_required. (Was: write denied.)
      allow write: if isAdmin();
    }
    // Moderation keyword list — read by the app's moderation engine, edited by admins.
    match /app_settings/moderation_config {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Home-screen announcement banner — read by the app, edited by admins.
    match /app_settings/home_announcement {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =============================
    // journal_prompts/{YYYY-MM-DD}  ("Prompt of the Day")
    // =============================
    match /journal_prompts/{dateId} {
      allow read: if isSignedIn();   // the app shows today's prompt
      allow write: if isAdmin();
    }

    // =============================
    // whispers/{YYYY-MM-DD}  (daily home-screen whisper)
    // =============================
    // Admin-authored, app-readable. Replaces a live zenquotes.io fetch: text
    // shown to users in a mental-health context must pass through review.
    match /whispers/{dateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =============================
    // broadcasts  (admin push audit log)
    // =============================
    match /broadcasts/{broadcastId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // =============================
    // volunteer_info  (doc id == user uid)
    // =============================
    match /volunteer_info/{volunteerId} {
      // Professional/verification info — readable by any signed-in user (the app shows
      // volunteer profiles & stats) and by admins reviewing applications.
      allow read: if isSignedIn();
      // The volunteer creates/edits their own; admins may edit (e.g. mirror status).
      allow create: if isOwner(volunteerId) || isAdmin();
      allow update: if isOwner(volunteerId)
                    || isAdmin()
                    // The review transaction may bump ONLY the aggregate stats,
                    // and only by a single review at a time. Previously the key
                    // set was constrained but the VALUES were not, so anyone
                    // could write averageRating: 5, totalReviews: 9999.
                    // A rating average can't be delta-checked in rules; the
                    // counters can, and bounding them bounds the damage.
                    // Server-side aggregation is the real fix — see §4.6.
                    || (isSignedIn() && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['averageRating', 'totalReviews', 'completedChats'])
                        && movesByOne('totalReviews')
                        && movesByOne('completedChats')
                        && request.resource.data.averageRating >= 0
                        && request.resource.data.averageRating <= 5);
      allow delete: if false;

      // Vetting documents (government ID / student ID image URLs). These are
      // Firebase download URLs that carry their own access token and BYPASS
      // Storage rules, so holding the URL is equivalent to holding the file.
      // They live in this private subcollection precisely so that the public
      // `volunteer_info` document — which the discovery UI reads for every
      // volunteer — cannot leak them.
      match /private/{docId} {
        allow read, write: if isOwner(volunteerId) || isAdmin();
      }

      // Reviews left for a volunteer after a chat (previously relied on the catch-all).
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        // Reviews are immutable to authors; admins can remove abusive reviews.
        allow update, delete: if isAdmin();
      }
    }

    // =============================
    // mood
    // =============================
    match /mood/{moodId} {
      // Mood entries are health data and `extraField` may carry private notes.
      // `allow read: if isSignedIn()` let any account read — and query — every
      // user's full mood history. Owner-scoped now; admins retain access for
      // the dashboard. Client queries must filter on userId (they already do).
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid)
                  || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // =============================
    // chats
    // PRIVACY NOTE: admins can READ chats/messages for life-safety escalation review
    // only (the panel surfaces them in the Escalation Review screen). Admins may also
    // END a chat (moderation) — but they can NEVER create or edit message content, and
    // never delete messages. This is a deliberate, narrow exception to "no chat text".
    // =============================
    match /chats/{chatId} {
      allow read: if (request.auth.uid in resource.data.participants) || isAdmin();
      // Participants manage their own chat. Admins may additionally END a chat
      // (status:'completed', endedBy:'admin', endedReason, endedAt) — the app already
      // reacts to endedBy=='admin' with "ended by a moderator".
      // Participants manage their own chat, but chatUpdateOk() blocks the two
      // dangerous edits: adding a third party to `participants` (which would
      // grant them the whole transcript, since message reads resolve against
      // the CURRENT array) and clearing `escalated`.
      allow update: if isAdmin()
                    || ((request.auth.uid in resource.data.participants)
                        && chatUpdateOk());
      // An escalated chat is evidence and must survive until a supervisor
      // resolves it (the admin panel clears the flag).
      // .get() with a default: most chat docs have no `escalated` field at all,
      // and reading a missing field is an evaluation error (which denies), not
      // a null — that would have blocked every ordinary chat deletion.
      allow delete: if (request.auth.uid in resource.data.participants)
                    && resource.data.get('escalated', false) != true;
      allow create: if request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // CREATE only. `allow write` also covers update and delete, so either
        // participant could silently rewrite or delete the other's messages
        // before a supervisor reviewed an escalation — which defeated the
        // "immutable evidence" property this comment claimed. Admins were
        // already blocked; participants are now too.
        allow create: if request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // =============================
    // escalations  (unified crisis feed — volunteer escalate + severe moderation)
    // =============================
    match /escalations/{escalationId} {
      // The creator must be one of the two people named. Previously any account
      // could fabricate a critical escalation about anyone and flood the
      // supervisor triage queue. A moderation escalation names the author
      // (userId == self); a volunteer escalation is raised BY the volunteer
      // (volunteerId == self).
      allow create: if isSignedIn()
                    && (request.resource.data.userId == request.auth.uid
                        || request.resource.data.get('volunteerId', '') == request.auth.uid);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // =============================
    // incident_reports  (clinical paper trail — immutable once filed)
    // =============================
    match /incident_reports/{reportId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // =============================
    // chat_requests
    // =============================
    match /chat_requests/{requestId} {
      // SECURITY / freemium: direct client creation is DENIED. All requests go
      // through the requestVolunteerChat callable (Admin SDK, bypasses rules),
      // which check-and-increments the free-tier welcome-chat counter atomically.
      // Allowing client creates here would let a free user create chats without
      // charging the counter — the exact bypass we're guarding against.
      allow create: if false;
      allow read, update: if isSignedIn()
                          && (request.auth.uid == resource.data.requesterId
                              || request.auth.uid == resource.data.volunteerId);
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.requesterId
                        || request.auth.uid == resource.data.volunteerId);
    }

    // =============================
    // communities  (admin-managed CRUD)
    // =============================
    match /communities/{communityId} {
      allow read: if isSignedIn();
      // Admin panel can now create/edit/delete communities. (Was: write denied.)
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    // Allow any signed-in user to join/leave by bumping ONLY the
                    // membersCount aggregate (client-side batch in joinCommunity()).
                    // Join/leave may move membersCount by exactly one. The key
                    // set was constrained before but the value was not, so
                    // anyone could set any community's count to any number —
                    // and the "popular communities" list orders by this field.
                    || (isSignedIn() && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['membersCount'])
                        && movesByOne('membersCount'));

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if (isSignedIn() && resource.data.senderId == request.auth.uid)
                              || isAdmin();
      }
    }

    // =============================
    // sounds  (admin-managed CRUD — soothing sounds library)
    // =============================
    // The doc is readable by everyone signed in, INCLUDING the `audio_path` of a
    // premium sound. That's fine: the path is not the file. Storage denies client
    // reads on sound_audio/**, so the only way to the bytes is the
    // getSoundAudioUrl callable, which checks entitlement.
    match /sounds/{soundId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =============================
    // posts + replies  (content moderation)
    // =============================
    match /posts/{postId} {
      allow read: if isSignedIn();
      // SECURITY / freemium: direct client creation is DENIED. All new threads go
      // through the createCommunityPost callable (Admin SDK, bypasses rules), which
      // enforces the free-tier monthly cap atomically and strips free-user mentions.
      // A client create here would skip the counter — the bypass we're guarding.
      allow create: if false;
      // Author edits own; admins edit for moderation; anyone may like/unlike.
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid)
                    || isAdmin()
                    || isOwnLikeToggle();
      // Only the author or an admin may delete.
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid)
                    || isAdmin();

      match /replies/{replyId} {
        allow read: if isSignedIn();
        // SECURITY / freemium: direct client creation is DENIED. All replies go
        // through the createCommunityReply callable (Admin SDK), which enforces
        // the free-tier monthly reply cap atomically and strips free-user
        // mentions. A client create here would skip the counter.
        allow create: if false;
        // Author edits own; admins edit for moderation; anyone may like/unlike.
        allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid)
                      || isAdmin()
                      || isOwnLikeToggle();
        // Only the author or an admin may delete.
        allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid)
                      || isAdmin();
      }
    }

    // =============================
    // moderation_flags  (admin review queue; carried over from prior rules)
    // The one client write allowed is recording a user's OWN blocked attempt.
    // Cloud Functions use the Admin SDK and bypass these rules entirely.
    // =============================
    match /moderation_flags/{flagId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.action == 'blocked');
    }

    // =============================
    // volunteer_blocks  (admin-created, time-boxed; carried over from prior rules)
    // The owning user may READ their blocks so the app can enforce them;
    // only admins create/modify them.
    // =============================
    match /volunteer_blocks/{blockId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =============================
    // daily_analytics  (dashboard reads; written by a backend Cloud Function)
    // =============================
    match /daily_analytics/{dateId} {
      allow read: if isAdmin();
      // The Admin SDK (Cloud Function) bypasses rules, so client writes stay denied.
      allow write: if false;
    }

    // =============================
    // security_logs  (minimal IP+timestamp safety trail for misconduct cases)
    // =============================
    // Fully denied to ALL clients — including the owner and admins. Only the
    // Admin SDK (Cloud Functions) writes it; admins READ it via the Firebase
    // console / Admin SDK, never the client. NOT analytics, NO GPS, NO content.
    match /security_logs/{docId} {
      allow read, write: if false;
    }

    // NO catch-all. Anything not matched above is denied by default.
  }
}
